{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticos.local/schemas/probe-result/v0.1.json",
  "title": "ProbeResult",
  "description": "Machine-readable outcome of one hostile-worker probe (AttackResult wire format). Phase Zero, v0.1.",
  "type": "object",
  "required": [
    "scenario_id",
    "attempted",
    "succeeded",
    "target",
    "error_type",
    "error_message",
    "started_at",
    "finished_at",
    "details"
  ],
  "properties": {
    "scenario_id": { "type": "string", "pattern": "^(AUTH|FS|ENV|PROC|NET|SOCK|WRITE)-[0-9]{2}$" },
    "attempted": { "type": "boolean" },
    "succeeded": { "type": "boolean" },
    "target": { "type": "string" },
    "error_type": { "type": ["string", "null"] },
    "error_message": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "details": { "type": "object" }
  },
  "additionalProperties": false
}
