{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticos.local/schemas/sandbox-policy/v0.1.json",
  "title": "SandboxPolicy",
  "description": "Expected policy outcome per attack scenario id. Phase Zero, v0.1.",
  "type": "object",
  "required": ["name", "version", "expectations"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "expectations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(FS|ENV|PROC|NET|SOCK|WRITE)-[0-9]{2}$" },
      "additionalProperties": {
        "type": "string",
        "enum": ["ALLOW", "DENY", "REQUIRE_APPROVAL"]
      }
    }
  },
  "additionalProperties": false
}
